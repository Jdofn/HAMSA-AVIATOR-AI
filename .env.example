APP_ENV=development
DATABASE_URL=sqlite:///./hamsa_dev.db
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
DASHBOARD_ACCESS_TOKEN=

# Required only when accepting signed provider webhooks. Keep secret outside Git.
LIVE_FEED_WEBHOOK_SECRET=

LOG_LEVEL=INFO

# Seconds before the authorized feed is marked stale (default: 300)
FEED_STALE_AFTER_SECONDS=300
